# Path to the SQLite database file
DB_PATH=./blems.db

# node-cron schedule expression
# Default: every 30 min, 6am-6pm, Mon-Fri
# Cron format: second minute hour day-of-month month day-of-week
CRON_SCHEDULE=0 */30 6-18 * * 1-5

# --- Alerts ---
# Set false to scrape and persist tires to the DB WITHOUT sending any email
# or Discord notifications. Useful for the first run after removing the
# scraper-level size filter — the DB will suddenly see dozens of small tires
# as "new" but you probably don't want an alert flood. Set this to false for
# the first scrape, then flip to true once you see the initial population.
ALERTS_ENABLED=true

# Minimum tire diameter in inches that triggers a public-feed alert. Per-user
# subscriptions (Phase 3+) apply their own filters independently. Set to 0 to
# disable this filter entirely.
PUBLIC_ALERT_MIN_DIAMETER=35

# --- Email (optional) ---
# Leave SMTP_USER blank to disable email notifications.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@gmail.com
NOTIFY_EMAILS=someone@gmail.com,another@gmail.com

# --- Discord Bot ---
# 1. Create app at https://discord.com/developers/applications
# 2. Bot tab -> Reset Token -> copy here
DISCORD_BOT_TOKEN=your-bot-token
# 3. OAuth2 -> General -> copy Application ID
DISCORD_CLIENT_ID=your-application-client-id
# 4. Your server's ID (right-click server -> Copy Server ID with Developer Mode on)
#    Setting this registers commands instantly for this guild only (dev mode).
#    Leave blank to register globally (up to 1 hour propagation).
DISCORD_GUILD_ID=your-server-id
# 5. The channel where automatic blem alerts are posted (the "public feed").
#    Right-click channel -> Copy Channel ID.
DISCORD_ALERT_CHANNEL_ID=channel-id
# 6. (Optional) Dedicated NL chat channel. Messages here open threads and use
#    LLM-assisted search. Leave blank to disable.
DISCORD_CHAT_CHANNEL_ID=

# --- GitHub Models LLM (for /ask and chat channel) ---
# Uses GitHub Models (models.inference.ai.azure.com) via your GitHub Copilot subscription.
# Required if DISCORD_CHAT_CHANNEL_ID is set or /ask is used.
#
# To get your API key:
#   1. github.com → Settings → Developer settings → Personal access tokens → Fine-grained tokens
#   2. Generate new token → Account permissions → Models → Read
#   3. Copy the token value here
#
# Note: Message Content privileged intent must be enabled in
#       Discord Developer Portal → Bot → Privileged Gateway Intents.
GITHUB_MODELS_API_KEY=
GITHUB_MODELS_API_BASE=https://models.inference.ai.azure.com
GITHUB_MODELS_MODEL=gpt-4o-mini
